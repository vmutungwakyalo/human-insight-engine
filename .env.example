# Supabase project URL and publishable key. Use the same values in both pairs.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Required for trusted server-side admin operations. Never use a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional local AI settings (these are the application defaults).
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:4b

# Optional cron authentication settings, if using authenticated cron requests.
# Generate a strong random value for CRON_SECRET before enabling cron requests.
# CRON_SECRET=YOUR_RANDOM_CRON_SECRET
# CRON_SECRET_PREVIOUS=YOUR_PREVIOUS_CRON_SECRET_DURING_ROTATION
